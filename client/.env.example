# Client environment.
# Copy to `.env` for local dev or set in Vercel project settings for prod.

# Backend API URL. Defaults to http://localhost:3001 if unset.
# In production set this to your deployed Render URL, e.g.
#   VITE_API_BASE=https://huskypath-api.onrender.com
VITE_API_BASE=http://localhost:3001
