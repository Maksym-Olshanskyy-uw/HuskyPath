# HuskyPath API environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

PORT=3001
NODE_ENV=development

# Comma-separated list of allowed origins for CORS in production.
# Leave blank in development (defaults to "any origin").
# Example: https://huskypath.vercel.app,https://huskypath-preview.vercel.app
CORS_ORIGIN=

# PostgreSQL (planned, not yet required by the server)
DATABASE_URL=postgresql://localhost:5432/huskypath

# Google Gemini API key for the NLP constraint parser
GEMINI_API_KEY=
